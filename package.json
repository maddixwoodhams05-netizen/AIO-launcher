{
  "name": "game-launcher",
  "version": "1.1.0",
  "description": "An all-in-one launcher for the games on your PC",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test --test-concurrency=1",
    "dist": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^26.15.3",
    "playwright-core": "^1.56.1"
  },
  "allowScripts": {
    "electron@33.4.11": true
  },
  "build": {
    "appId": "com.maddix.gamelauncher",
    "productName": "Game Launcher",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "icon": "build/icon.png",
      "artifactName": "Game-Launcher-${version}-portable.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Game Launcher",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "Game-Launcher-Setup-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "maddixwoodhams05-netizen",
        "repo": "AIO-launcher"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
